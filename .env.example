UMAIL_STACK=uMail
UMAIL_DOMAIN=
# JSON manifest; replace the example with this installation's mail domains.
UMAIL_MAIL_DOMAINS='[{"name":"mail.example.com","receive":true,"send":true}]'
UMAIL_OPERATOR_EMAIL=
UMAIL_OPERATOR_PASSWORD=
CF_EMAIL_ROUTING_TOKEN=
CF_EMAIL_ROUTING_RULES_TOKEN=

# Only true for an existing installation's first controller rollout.
UMAIL_LEGACY_CATCH_ALL=false
UMAIL_LEGACY_SEED_RULES=false

# Only for token-based deployment. Leave commented when using an OAuth profile.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
