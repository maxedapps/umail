{
  "name": "umail",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && pnpm -r typecheck",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt .",
    "test": "vitest run && pnpm test:worker && pnpm -r --if-present test:worker && pnpm -r --if-present test:browser",
    "test:worker": "agents heavy -- vitest run --config vitest.worker.config.ts",
    "gate": "agents heavy -- tools/gate.sh",
    "build:clients": "tsdown",
    "alchemy": "alchemy",
    "umail": "node apps/cli/src/bin.ts",
    "deploy:stage": "agents heavy -- alchemy deploy",
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --oxlint"
  },
  "devDependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.81",
    "@cloudflare/vitest-plugin": "1.4.0",
    "@cloudflare/workers-types": "5.20261009.1",
    "@effect/platform-node": "4.0.2",
    "@effect/tsgo": "0.51.1",
    "@effect/vitest": "4.0.2",
    "@oxlint/plugins": "1.87.0",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.0.3",
    "alchemy": "2.0.0-beta.81",
    "better-auth": "1.7.7",
    "effect": "4.0.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2003",
    "playwright": "1.64.0",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.13.1"
}
