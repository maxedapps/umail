{
  "name": "umail",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && pnpm -r typecheck",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt .",
    "test": "vitest run && pnpm test:worker && pnpm -r --if-present test:worker && pnpm -r --if-present test:browser",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "gate": "tools/gate.sh",
    "build:clients": "tsdown",
    "umail": "agents run --env prod -- node apps/cli/src/bin.ts",
    "deploy:stage": "tools/deploy.sh",
    "prepare": "effect-tsgo patch --typescript-package @typescript/native --oxlint"
  },
  "devDependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.85",
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@alchemy.run/domain": "2.0.0-beta.85",
    "@cloudflare/vitest-plugin": "1.5.1",
    "@cloudflare/workers-types": "5.20261026.1",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.67.1",
    "@effect/vitest": "4.1.2",
    "@oxlint/plugins": "1.91.0",
    "@types/node": "24.19.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/browser-playwright": "5.1.0",
    "alchemy": "2.0.0-beta.85",
    "better-auth": "1.7.7",
    "effect": "4.1.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.0",
    "tsdown": "0.23.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.13.1"
}
